# Supabase — from Project Settings → API in the Supabase dashboard.
# Both of these are safe to expose to the browser: the anon key only ever
# grants what the RLS policies in supabase/migrations allow.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Never expose this one. It bypasses RLS entirely. Reach it only through
# src/lib/supabase/service.ts, which is marked `server-only` so importing it
# from a Client Component is a build error rather than a leaked key.
# Required in production: sending push needs to read push_subscriptions,
# which has no SELECT policy by design.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Maps Platform — Google Cloud Console → APIs & Services → Credentials.
# Requires a billing account (a card on file) even to stay within the free
# 10,000-loads/month quota; see README for the exact setup steps, including
# restricting the key so it can't be used from any other site.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Web Push (VAPID). Generate a pair with:  npx web-push generate-vapid-keys
# The public key is handed to the browser when it subscribes; the private key
# signs the sends and must stay server-side. Rotating them invalidates every
# existing subscription, so set them once.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# Contact address the push services can reach you at if a send misbehaves.
VAPID_SUBJECT=mailto:you@example.com
