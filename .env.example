# Supabase — from Project Settings → API in the Supabase dashboard.
# Both of these are safe to expose to the browser: the anon key only ever
# grants what the RLS policies in supabase/migrations allow.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Never expose this one. Used only by local seeding / admin scripts, which
# bypass RLS. Do not import it into anything under src/app.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
